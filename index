<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>The Light Powerhouse — Track Your Order</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: #f5f7fa;
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 20px;
    }
    .container {
      max-width: 640px;
      width: 100%;
      background: white;
      border-radius: 20px;
      box-shadow: 0 20px 60px rgba(0,0,0,0.1);
      padding: 40px 35px;
    }
    .header { text-align: center; margin-bottom: 32px; }
    .header .logo { font-size: 32px; font-weight: 700; color: #f5a623; }
    .header .logo span { color: #1a1a2e; }
    .header .subtitle { color: #666; font-size: 14px; margin-top: 4px; }
    .header .location { color: #888; font-size: 13px; margin-top: 2px; }

    .search-section {
      background: #f8f9fc;
      border-radius: 16px;
      padding: 24px 20px;
      margin-bottom: 24px;
    }
    .search-section label {
      display: block;
      font-weight: 600;
      color: #1a1a2e;
      margin-bottom: 12px;
      font-size: 15px;
    }
    .input-row {
      display: flex;
      gap: 10px;
    }
    .input-row input {
      flex: 1;
      padding: 14px 18px;
      border: 2px solid #e2e8f0;
      border-radius: 12px;
      font-size: 16px;
      transition: border-color 0.2s;
      outline: none;
    }
    .input-row input:focus { border-color: #f5a623; }
    .input-row button {
      padding: 14px 28px;
      background: #f5a623;
      color: white;
      border: none;
      border-radius: 12px;
      font-size: 16px;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.2s, transform 0.1s;
      white-space: nowrap;
    }
    .input-row button:hover { background: #e09515; }
    .input-row button:active { transform: scale(0.97); }
    .input-row button:disabled { opacity: 0.6; cursor: not-allowed; }

    .input-toggle {
      display: flex;
      gap: 20px;
      margin-top: 14px;
    }
    .input-toggle label {
      display: flex;
      align-items: center;
      gap: 8px;
      font-weight: 400;
      font-size: 14px;
      color: #444;
      cursor: pointer;
      margin-bottom: 0;
    }
    .input-toggle input[type="radio"] {
      accent-color: #f5a623;
      width: 16px;
      height: 16px;
      cursor: pointer;
    }

    .message {
      padding: 14px 18px;
      border-radius: 12px;
      margin-bottom: 16px;
      display: none;
    }
    .message.error {
      display: block;
      background: #fee2e2;
      color: #991b1b;
      border: 1px solid #fecaca;
    }
    .message.loading {
      display: block;
      background: #e0f2fe;
      color: #075985;
      border: 1px solid #bae6fd;
    }
    .message .spinner {
      display: inline-block;
      width: 18px;
      height: 18px;
      border: 3px solid #bae6fd;
      border-top-color: #075985;
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
      margin-right: 10px;
      vertical-align: middle;
    }
    @keyframes spin { to { transform: rotate(360deg); } }

    .results { display: none; }
    .results.visible { display: block; }

    .order-card {
      background: #f8f9fc;
      border-radius: 16px;
      padding: 20px;
      border-left: 5px solid #f5a623;
    }
    .order-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      margin-bottom: 12px;
    }
    .order-header .order-id {
      font-weight: 600;
      color: #1a1a2e;
      font-size: 18px;
    }
    .order-header .badge {
      padding: 6px 14px;
      border-radius: 20px;
      font-size: 13px;
      font-weight: 600;
    }
    .badge.delivered { background: #d1fae5; color: #065f46; }
    .badge.transit { background: #fef3c7; color: #92400e; }
    .badge.pending { background: #e0e7ff; color: #3730a3; }
    .badge.cancelled { background: #fee2e2; color: #991b1b; }

    .order-details {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 6px 20px;
      font-size: 14px;
      color: #444;
      margin-top: 8px;
    }
    .order-details .detail-item {
      display: flex;
      justify-content: space-between;
      padding: 4px 0;
    }
    .order-details .detail-item .label { color: #888; }
    .order-details .detail-item .value { font-weight: 500; color: #1a1a2e; }

    .timeline { margin-top: 20px; }
    .timeline h4 {
      font-size: 14px;
      color: #666;
      margin-bottom: 12px;
      font-weight: 600;
    }
    .timeline-item {
      display: flex;
      gap: 14px;
      padding: 10px 0;
      border-bottom: 1px solid #edf2f7;
    }
    .timeline-item:last-child { border-bottom: none; }
    .timeline-dot {
      width: 12px;
      height: 12px;
      min-width: 12px;
      border-radius: 50%;
      margin-top: 4px;
    }
    .timeline-dot.completed { background: #22c55e; }
    .timeline-dot.current { background: #f5a623; }
    .timeline-dot.pending { background: #d1d5db; }

    .timeline-content .activity { font-weight: 500; color: #1a1a2e; font-size: 14px; }
    .timeline-content .meta { font-size: 13px; color: #888; margin-top: 2px; }

    .not-found {
      text-align: center;
      padding: 30px 20px;
    }
    .not-found .icon { font-size: 48px; margin-bottom: 12px; }
    .not-found h3 { color: #1a1a2e; margin-bottom: 6px; }
    .not-found p { color: #888; font-size: 14px; }

    .footer {
      text-align: center;
      margin-top: 28px;
      font-size: 13px;
      color: #aaa;
      border-top: 1px solid #edf2f7;
      padding-top: 20px;
    }

    @media (max-width: 480px) {
      .container { padding: 24px 18px; }
      .input-row { flex-direction: column; }
      .input-row button { width: 100%; }
      .order-details { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>

<div class="container">
  <!-- Header -->
  <div class="header">
    <div class="logo">⚡ The Light <span>Powerhouse</span></div>
    <div class="subtitle">Track Your Order</div>
    <div class="location">📍 Anand, Gujarat</div>
  </div>

  <!-- Search Section -->
  <div class="search-section">
    <label for="trackInput">Enter Mobile Number or AWB Number</label>
    <div class="input-row">
      <input
        type="text"
        id="trackInput"
        placeholder="e.g. 9876543210 or 788830567028"
        autocomplete="off"
      />
      <button id="trackBtn">🔍 Track</button>
    </div>
    <div class="input-toggle">
      <label><input type="radio" name="inputType" value="mobile" checked /> 📱 Mobile Number</label>
      <label><input type="radio" name="inputType" value="awb" /> 📦 AWB Number</label>
    </div>
  </div>

  <!-- Message Area -->
  <div id="message" class="message"></div>

  <!-- Results -->
  <div id="results" class="results">
    <div id="orderCard" class="order-card"></div>
  </div>

  <!-- Footer -->
  <div class="footer">
    The Light Powerhouse &bull; Anand, Gujarat &bull; Support: +91 98765 43210
  </div>
</div>

<script>
  // ─── CONFIGURATION ──────────────────────────────────────────
  // ⚠️  CHANGE THIS TO YOUR BACKEND API URL
  const API_BASE = 'https://light-powerhouse-api.onrender.com/api';

  // ─── DOM REFS ──────────────────────────────────────────────
  const trackInput = document.getElementById('trackInput');
  const trackBtn = document.getElementById('trackBtn');
  const messageEl = document.getElementById('message');
  const resultsEl = document.getElementById('results');
  const orderCard = document.getElementById('orderCard');
  const inputTypeRadios = document.querySelectorAll('input[name="inputType"]');

  // ─── HELPERS ──────────────────────────────────────────────
  function getInputType() {
    for (const radio of inputTypeRadios) if (radio.checked) return radio.value;
    return 'mobile';
  }

  function showMessage(text, type = 'loading') {
    messageEl.className = `message ${type}`;
    if (type === 'loading') {
      messageEl.innerHTML = `<span class="spinner"></span> ${text}`;
    } else {
      messageEl.textContent = text;
    }
  }
  function hideMessage() { messageEl.className = 'message'; messageEl.textContent = ''; }

  function showResults(data) {
    resultsEl.className = 'results visible';
    orderCard.innerHTML = buildOrderHTML(data);
  }
  function hideResults() { resultsEl.className = 'results'; orderCard.innerHTML = ''; }

  function showNotFound() {
    resultsEl.className = 'results visible';
    orderCard.innerHTML = `
      <div class="not-found">
        <div class="icon">🔍</div>
        <h3>Order Not Found</h3>
        <p>We couldn't find any order matching that number.<br>Please check and try again.</p>
      </div>
    `;
  }

  function escapeHtml(text) {
    if (!text) return '';
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }

  function getStatusClass(status) {
    const s = (status || '').toLowerCase();
    if (s.includes('delivered') || s.includes('completed')) return 'delivered';
    if (s.includes('transit') || s.includes('shipped') || s.includes('in transit')) return 'transit';
    if (s.includes('cancel')) return 'cancelled';
    return 'pending';
  }

  function formatStatus(status) {
    if (!status) return 'Unknown';
    return status.charAt(0).toUpperCase() + status.slice(1);
  }

  // ─── BUILD ORDER HTML ──────────────────────────────────────
  function buildOrderHTML(data) {
    const statusClass = getStatusClass(data.status);
    const statusDisplay = formatStatus(data.status);
    const timelineHTML = (data.timeline || []).length > 0
      ? data.timeline.map((item, index) => {
          const dotClass = index === 0 ? 'completed' :
                           index === data.timeline.length - 1 ? 'current' : 'completed';
          return `
            <div class="timeline-item">
              <div class="timeline-dot ${dotClass}"></div>
              <div class="timeline-content">
                <div class="activity">${escapeHtml(item.activity || 'Update')}</div>
                <div class="meta">${item.date || ''} ${item.time || ''} ${item.location ? '• ' + escapeHtml(item.location) : ''}</div>
              </div>
            </div>
          `;
        }).join('')
      : '<p style="color:#888;font-size:14px;">No tracking updates available yet.</p>';

    return `
      <div class="order-header">
        <span class="order-id">Order #${escapeHtml(data.orderId || data.trackingId || 'N/A')}</span>
        <span class="badge ${statusClass}">${statusDisplay}</span>
      </div>
      <div class="order-details">
        <div class="detail-item"><span class="label">Courier</span><span class="value">${escapeHtml(data.courier || 'Unknown')}</span></div>
        <div class="detail-item"><span class="label">AWB Number</span><span class="value">${escapeHtml(data.trackingId || 'N/A')}</span></div>
        <div class="detail-item"><span class="label">Status</span><span class="value">${statusDisplay}</span></div>
        ${data.estimatedDelivery ? `
          <div class="detail-item"><span class="label">Est. Delivery</span><span class="value">${escapeHtml(data.estimatedDelivery)}</span></div>
        ` : ''}
      </div>
      <div class="timeline">
        <h4>📍 Tracking Timeline</h4>
        ${timelineHTML}
      </div>
    `;
  }

  // ─── API CALL ──────────────────────────────────────────────
  async function trackOrder() {
    const value = trackInput.value.trim();
    if (!value) {
      showMessage('Please enter a mobile number or AWB number.', 'error');
      return;
    }

    const inputType = getInputType();
    hideResults();
    showMessage('Fetching tracking information...', 'loading');
    trackBtn.disabled = true;

    try {
      const endpoint = `${API_BASE}/track/${inputType}/${encodeURIComponent(value)}`;
      const response = await fetch(endpoint);
      const data = await response.json();

      if (!response.ok) {
        if (response.status === 404) {
          hideMessage();
          showNotFound();
          return;
        }
        throw new Error(data.error || 'Failed to fetch tracking information');
      }

      hideMessage();
      showResults(data);

    } catch (error) {
      console.error('Tracking error:', error);
      showMessage(error.message || 'Something went wrong. Please try again.', 'error');
      hideResults();
    } finally {
      trackBtn.disabled = false;
    }
  }

  // ─── EVENT LISTENERS ──────────────────────────────────────
  trackBtn.addEventListener('click', trackOrder);
  trackInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') trackOrder(); });

  // Auto‑detect input type
  trackInput.addEventListener('input', () => {
    const v = trackInput.value.trim();
    if (/^\d{10}$/.test(v)) {
      document.querySelector('input[name="inputType"][value="mobile"]').checked = true;
    } else if (/^[A-Za-z0-9]{6,}$/.test(v)) {
      document.querySelector('input[name="inputType"][value="awb"]').checked = true;
    }
  });

  trackInput.focus();
</script>
</body>
</html>
